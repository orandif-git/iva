# Copy to .env and change every secret. Generate secrets with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# Generate the key-encryption key with:  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
GI_ENV=dev
GI_DATABASE_URL=postgresql://gi_api:change-me@localhost:5432/gateinsight
GI_JWT_SECRET_CUSTOMER=
GI_JWT_SECRET_PLATFORM=
GI_SERVICE_TOKEN=
GI_KEY_ENCRYPTION_KEY=
GI_REGISTRAR_HOST=connect.example.com
GI_ISUP_PORT=7660
GI_AUTO_REGISTER_PORT=9500
GI_CORS_ORIGINS=["http://localhost:3000"]

# Registrar (separate process, GI_REG_ prefix)
# GI_REG_BACKEND_URL=http://127.0.0.1:8000
# GI_REG_SERVICE_TOKEN=            # same value as GI_SERVICE_TOKEN
# GI_REG_PUBLIC_IP=203.0.113.10    # the address recorders can reach
# Backend side, must match the registrar's REALM and SERVER_ID:
# GI_GB_REALM=3402000000
# GI_GB_SERVER_ID=34020000002000000001
# GI_GB_PORT=5060

# Alerts: messaging and evidence pictures
# GI_PUBLIC_BASE_URL=https://app.example.com     # evidence links sent to people are built from this
# GI_EVIDENCE_BACKEND=r2                            # r2 (Cloudflare R2) or local (development only)
# GI_R2_ACCOUNT_ID=
# GI_R2_ACCESS_KEY_ID=
# GI_R2_SECRET_ACCESS_KEY=
# GI_R2_BUCKET=gate-insight-evidence                # a PRIVATE bucket: nobody is ever given a bucket address
# GI_EVIDENCE_LINK_TTL_HOURS=72
# Retention is set per tenant in the admin console (events days, pictures days).
# WhatsApp and email providers are not set here: the owner configures them in the admin console.
